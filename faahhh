local function isStandingOnBaseplate(hrp)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {char}
    local raycastResult = workspace:Raycast(hrp.Position, Vector3_new(0, -6, 0), raycastParams)
    if raycastResult and raycastResult.Instance then
        if raycastResult.Instance.Name:lower():find("baseplate") then
            return true
        end
    end
    return false
end

function processHit(hit, sourcePart)
    if damageState == "Disabled" or not hit or not hit:IsA("BasePart") then return end
    if not sourcePart or not isKillPart(sourcePart) then return end
    if hit:IsDescendantOf(char) or isProjectileEffect(hit) then return end

    local sourceName = sourcePart.Name:lower()
    if (sourceName:find("sword") or sourceName:find("espada")) and not swordLethal then return end

    local victimModel = hit:FindFirstAncestorOfClass("Model")
    local victimHumanoid = victimModel and victimModel:FindFirstChildOfClass("Humanoid")

    if sourceName:find("cyl") and not victimHumanoid then return end

    if damageState == "PlayerDamage" then
        if not victimHumanoid then return end
    elseif damageState == "AOEParts" then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and isStandingOnBaseplate(hrp) then
            if hit.Name:lower():find("baseplate") then return end
        end
        if hit.Locked then return end
    end

    if hit.Name == "Terrain" or hit:GetAttribute("F3X_Destroying") then return end

    for _, data in pairs(trackedParts) do
        if data.sPart == hit then return end
    end

    if victimHumanoid and victimModel ~= char then
        if victimModel:GetAttribute("F3X_Damaging") then return end
        victimModel:SetAttribute("F3X_Damaging", true)

        task.spawn(function()
            pcall(function()
                local newHealth = math.max(0, victimHumanoid.Health - CUSTOM_DAMAGE)
                if newHealth <= 0 then
                    local allParts = {}
                    for _, p in ipairs(victimModel:GetDescendants()) do
                        if p:IsA("BasePart") and not isProjectileEffect(p) then
                            table.insert(allParts, p)
                        end
                    end
                    
                    local partsToDelete = {}
                    local selectedParts = {}
                    for i = 1, math.min(3, #allParts) do
                        local randIdx = math_random(1, #allParts)
                        local chosenPart = table.remove(allParts, randIdx)
                        table.insert(selectedParts, chosenPart)
                        table.insert(partsToDelete, chosenPart)
                    end

                    for _, p in ipairs(selectedParts) do
                        playDestructionEffect(p)
                    end

                    for _, p in ipairs(allParts) do
                        table.insert(partsToDelete, p)
                    end

                    pcall(function()
                        if Remote then Remote:InvokeServer("Remove", partsToDelete) end
                    end)
                else
                    victimHumanoid.Health = newHealth
                end
            end)
            task.wait(HIT_COOLDOWN)
            if victimModel then
                victimModel:SetAttribute("F3X_Damaging", nil)
            end
        end)
    else
        if damageState == "PlayerDamage" then return end
        hit:SetAttribute("F3X_Destroying", true)
        
        playDestructionEffect(hit)

        local meshInfo = hit:FindFirstChildOfClass("SpecialMesh")
        table.insert(destroyedHistory, {
            Name = hit.Name,
            Parent = hit.Parent,
            Shape = (hit:IsA("WedgePart") and "Wedge") or (hit:IsA("Part") and hit.Shape == Enum.PartType.Ball and "Ball") or (hit:IsA("Part") and hit.Shape == Enum.PartType.Cylinder and "Cylinder") or "Normal",
            CFrame = hit.CFrame,
            Size = hit.Size,
            Color = hit.Color,
            Material = hit.Material,
            Transparency = hit.Transparency,
            Reflectance = hit.Reflectance,
            Anchored = hit.Anchored,
            TopSurface = hit.TopSurface,
            BottomSurface = hit.BottomSurface,
            LeftSurface = hit.LeftSurface,
            RightSurface = hit.RightSurface,
            FrontSurface = hit.FrontSurface,
            BackSurface = hit.BackSurface,
            MeshType = meshInfo and meshInfo.MeshType or Enum.MeshType.FileMesh,
            MeshId = (hit:IsA("MeshPart") and hit.MeshId) or (meshInfo and meshInfo.MeshId) or "",
            TextureId = (hit:IsA("MeshPart") and hit.TextureID) or (meshInfo and meshInfo.TextureId) or "",
            Scale = meshInfo and meshInfo.Scale or Vector3_new(1, 1, 1)
        })

        task.spawn(function()
            pcall(function()
                if Remote then Remote:InvokeServer("Remove", {hit}) end
            end)
        end)
    end
end

