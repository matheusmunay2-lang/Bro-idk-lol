-- 💬 CHAT COMMANDS: setting/end & purge/"targetname"
LP.Chatted:Connect(function(msg)
    local msgLower = msg:lower()

    if msgLower == "setting/end" then
        scriptActive = false
        local removes = {}
        for _, data in pairs(trackedParts) do
            if data.sPart then
                table.insert(removes, data.sPart)
            end
        end
        pcall(function()
            if Remote and #removes > 0 then
                Remote:InvokeServer("Remove", removes)
            end
        end)
        trackedParts = {}
        pendingMirror = {}
        sendNotification("F3X System", "Todas as meshes e partes foram deletadas (setting/end).")
        return
    end

    if msgLower:sub(1, 6) == "purge/" then
        local targetName = msg:sub(7):gsub('"', ''):gsub("'", ""):lower()
        local countDeleted = 0

        local function checkAndDelete(container)
            if not container then return end
            for _, item in ipairs(container:GetChildren()) do
                if item.Name:lower():find(targetName) then
                    item:Destroy()
                    countDeleted = countDeleted + 1
                end
            end
        end

        checkAndDelete(LP.Backpack)
        checkAndDelete(LP.Character)
        checkAndDelete(LP.PlayerGui)

        sendNotification("Purge System", countDeleted .. " item(ns) correspondentes a '" .. targetName .. "' foram deletados.")
        return
    end
end)

