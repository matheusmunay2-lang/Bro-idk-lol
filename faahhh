    if isSFXPart(part) or part:FindFirstAncestor("Effects") or part:FindFirstAncestor("SFXFolder") or part:FindFirstAncestor("FXFolder") or part:FindFirstAncestor("DFXFolder") then
        return true
    end
    if nameLower == "classicball" or nameLower == "idiof" or nameLower == "cralv3" or nameLower == "classicsphere" or nameLower == "glow" or nameLower == "gunglow" or nameLower == "shoot" then
        return true
    end
    return false
end

local function isProjectileEffect(part)
    if not part or not part:IsA("BasePart") then return false end
    local name = part.Name:lower()
    if name:find("shoot") or name:find("shootsphere") or name:find("cyl") or name:find("bullet") or name:find("fx") or name:find("laser") or name:find("ray") or name:find("beam") or name:find("tracer") or name:find("tiro") or name:find("projetil") or isSFXPart(part) then
        return true
    end
    local sm = part:FindFirstChildOfClass("SpecialMesh")
    if sm then
        local meshId = tostring(sm.MeshId):lower()
        if meshId:find("shoot") then return true end
    end
    return false
end

local function isKillPart(part)
    if not part or not part:IsA("BasePart") then return false end
