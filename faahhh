local function isSFXPart(part)
    if not part then return false end
    if part:FindFirstAncestor("SFXFolder") ~= nil or part:FindFirstAncestor("DFXFolder") ~= nil or part:FindFirstAncestor("FXFolder") ~= nil or part:FindFirstAncestor("Effects") ~= nil or part:FindFirstAncestor("Debris") ~= nil or part:FindFirstAncestor("FloorVisualizer") ~= nil then
        return true
    end
    local sfxFolder = workspace:FindFirstChild("SFXFolder")
    if sfxFolder and part:IsDescendantOf(sfxFolder) then
        if part:IsA("WedgePart") or part:IsA("Part") and (part.Shape == Enum.PartType.Ball or part.Shape == Enum.PartType.Cylinder) then
            return true
        end
    end
    return false
end

local function shouldBeNeon(part)
