local lastSync = 0
local SYNC_INTERVAL = 0.033
local rotationAngle = 0

RS.Heartbeat:Connect(function(dt)
    if not scriptActive then return end
    rotationAngle = rotationAngle + (dt * 15)

    lastSync = lastSync + dt
    if lastSync < SYNC_INTERVAL then return end
    lastSync = 0

    local moves, removes, colors, materials, resizes, locks, meshUpdates = {}, {}, {}, {}, {}, {}, {}

    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") and v.Locked == true then
            v.Locked = false
        end
    end

    local classicSphere = char:FindFirstChild("ClassicSphere") or workspace:FindFirstChild("ClassicSphere")
    local headMeshPart = char:FindFirstChild("HeadMeshPart")
    local neckMeshPart = char:FindFirstChild("NeckMeshPart")

    if classicSphere then
        if headMeshPart and headMeshPart.Color ~= classicSphere.Color then
            headMeshPart.Color = classicSphere.Color
        end
        if neckMeshPart and neckMeshPart.Color ~= classicSphere.Color then
            neckMeshPart.Color = classicSphere.Color
        end

        for localPart, data in pairs(trackedParts) do
            local acc = localPart:FindFirstAncestorOfClass("Accessory")
            local isScarfOrGlasses = acc and (acc.Name == "VigilanteScarfCrimson" or acc.Name == "Accessory (KemonoGlasses)") or (acc and acc.Name:lower():find("kitsune"))
            local isArmInPart = localPart.Name:find("ArmIn") ~= nil or localPart.Name == "ArmIn"
            local isHeadMesh = localPart.Name == "HeadMeshPart"
            local isNeckMesh = localPart.Name == "NeckMeshPart"
            local isVisualizedMesh = localPart.Name == "CubeOutline" or localPart.Name == "F3X_VisualizerMeshGlobal" or localPart.Name == "F3X_VisualizedMeshGlobal" or localPart.Name == "F3X_Visualized"

            if isScarfOrGlasses or isArmInPart or isHeadMesh or isNeckMesh or isVisualizedMesh then
                local targetColor = classicSphere.Color
                if localPart.Color ~= targetColor then
                    localPart.Color = targetColor
                    table.insert(colors, {Part = data.sPart, Color = targetColor})
                end
            end

            local isArmOutPart = localPart.Name:find("ArmOut") ~= nil
            if isArmOutPart then
                local blackColor = Color3.new(0, 0, 0)
                if localPart.Color ~= blackColor then
                    localPart.Color = blackColor
                    table.insert(colors, {Part = data.sPart, Color = blackColor})
                end
            end
        end
    end

    for localPart, data in pairs(trackedParts) do
        if not localPart.Parent or not localPart:IsDescendantOf(game) then
            if data.sPart then table.insert(removes, data.sPart) end
            trackedParts[localPart] = nil
            continue
        end

        local currentCFrame = localPart.CFrame
        if localPart.Name:find("RotBullets") then
            currentCFrame = localPart.CFrame * CFrame_Angles(0, 0, rotationAngle)
        end

        if currentCFrame ~= data.CFrame then
            data.CFrame = currentCFrame
            table.insert(moves, {Part = data.sPart, CFrame = currentCFrame})
        end

        if localPart.Size ~= data.LastSize then
            data.LastSize = localPart.Size
            table.insert(resizes, {Part = data.sPart, CFrame = currentCFrame, Size = localPart.Size})
            if data.Mesh and data.MeshId and data.MeshId ~= "" then
                local _, _, _, _, newScale = getMeshInfo(localPart)
                if (newScale - data.Scale).Magnitude > 0.001 then
                    data.Scale = newScale
                    table.insert(meshUpdates, {Part = data.sPart, MeshType = data.MeshType, MeshId = data.MeshId, TextureId = "", Scale = newScale})
                end
            end
        end

        if localPart.Color ~= data.LastColor then
            data.LastColor = localPart.Color
            table.insert(colors, {Part = data.sPart, Color = localPart.Color})
        end

        local desiredMaterial = localPart.Material
        if shouldBeNeon(localPart) then
            desiredMaterial = Enum.Material.Neon
        end

        if desiredMaterial ~= data.LastMaterial or localPart.Transparency ~= data.LastTrans then
            data.LastMaterial = desiredMaterial
            data.LastTrans = localPart.Transparency
            local sTrans = isBodyOrVisualizer(localPart) and 0 or localPart.Transparency
            table.insert(materials, {Part = data.sPart, Material = desiredMaterial, Transparency = sTrans})
        end

        if data.sPart and data.sPart.Locked == false then
            table.insert(locks, data.sPart)
        end

        localPart.LocalTransparencyModifier = 1
    end

    pcall(function()
        if Remote then
            if #moves > 0 then Remote:InvokeServer("SyncMove", moves) end
            if #resizes > 0 then Remote:InvokeServer("SyncResize", resizes) end
            if #meshUpdates > 0 then Remote:InvokeServer("SyncMesh", meshUpdates) end
            if #removes > 0 then Remote:InvokeServer("Remove", removes) end
            if #colors > 0 then Remote:InvokeServer("SyncColor", colors) end
            if #materials > 0 then Remote:InvokeServer("SyncMaterial", materials) end
            if #locks > 0 then Remote:InvokeServer("SetLocked", locks, true) end
        end
    end)
end)

