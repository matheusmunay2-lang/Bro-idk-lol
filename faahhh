end

local function playDestructionEffect(originalPart)
    if not originalPart or not originalPart:IsA("BasePart") then return end
    task.spawn(function()
        local clone = originalPart:Clone()
        if not clone then return end
        
        if clone:IsA("Part") then
            clone.Shape = Enum.PartType.Ball
        end
        
        clone.Anchored = false
        clone.CanCollide = false
        clone.CanQuery = false
        clone.Massless = true
        clone.Material = Enum.Material.Neon
        clone.Color = getClassicSphereColor()
        
        local startTrans = math.clamp(originalPart.Transparency, 0, 0.5)
        clone.Transparency = startTrans

        for _, child in ipairs(clone:GetChildren()) do
            if child:IsA("Texture") or child:IsA("Decal") then
                child:Destroy()
            elseif child:IsA("SpecialMesh") then
                child.TextureId = ""
                child.MeshType = Enum.MeshType.Sphere
            elseif child:IsA("MeshPart") then
                clone.TextureID = ""
            end
        end
        if clone:IsA("MeshPart") then clone.TextureID = "" end

        local att0 = Instance.new("Attachment", clone)
        att0.Position = Vector3_new(0, 0, 0)
        local att1 = Instance.new("Attachment", clone)
        att1.Position = Vector3_new(0, -1.5, 0)

        local trail = Instance.new("Trail")
        trail.Attachment0 = att0
        trail.Attachment1 = att1
        trail.Color = ColorSequence.new(getClassicSphereColor())
        trail.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.2),
            NumberSequenceKeypoint.new(1, 1)
        })
        trail.Lifetime = 0.4
        trail.Parent = clone

        clone.Parent = workspace

        local randomOffset = Vector3_new(math_random(-15, 15), math_random(6, 20), math_random(-15, 15))
        local targetCFrame = clone.CFrame * CFrame_new(randomOffset)
        
        local baseSize = clone.Size.Magnitude > 0 and clone.Size or Vector3_new(2, 2, 2)
        local stretchedSize = Vector3_new(baseSize.X * 0.7, baseSize.Y * 2.2, baseSize.Z * 0.7)

        local tweenInfo = TweenInfo.new(1.2, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)
        local tween = TweenService:Create(clone, tweenInfo, {
            CFrame = targetCFrame,
            Transparency = 1,
            Size = stretchedSize
        })
        tween:Play()
        tween.Completed:Connect(function()
            if clone and clone.Parent then clone:Destroy() end
        end)
    end)
end

local function isBodyOrVisualizer(part)
