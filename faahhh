local function generateRandomString(length)
    length = length or math_random(10, 18)
    local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local sb = {}
    for i = 1, length do
        local randIdx = math_random(1, #chars)
        table.insert(sb, chars:sub(randIdx, randIdx))
    end
    return table.concat(sb)
end

