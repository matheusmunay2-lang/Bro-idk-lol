    if limbNames[part.Name] and part.Parent == char then return true end
    if part.Name:find("Visualizer") and part.Name ~= "F3X_VisualizerMeshGlobal" and part.Name ~= "F3X_VisualizedMeshGlobal" and part.Name ~= "CubeOutline" then return true end
