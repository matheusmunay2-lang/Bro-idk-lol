local function getWorkspaceMeshReference(partName)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name == partName and not obj:IsDescendantOf(char) then
            local mp = obj:IsA("MeshPart") and obj.MeshId ~= "" and obj.MeshId or nil
            if mp then
                return mp, obj.TextureID, obj.Size / obj.MeshSize
            end
            local sm = obj:FindFirstChildOfClass("SpecialMesh")
            if sm and sm.MeshId ~= "" then
                return sm.MeshId, sm.TextureId, sm.Scale
            end
        end
    end
    return nil, nil, nil
end

local function getMeshInfo(part)
    local nameLower = part.Name:lower()

    if part.Name == "F3X_VisualizerMeshGlobal" or part.Name == "F3X_VisualizedMeshGlobal" or part.Name == "F3X_Visualized" or part.Name == "CubeOutline" or nameLower == "idk" then
        local scale = part.Size * CUBE_OUTLINE_SCALE_MULTIPLIER
        return true, Enum.MeshType.FileMesh, TARGET_CUBE_MESH, "", scale
    end

    if nameLower == "hit2" or nameLower == "hit4" or nameLower == "shootsphere" or part.Name == "ClassicSphere" or part.Name == "ClassicBall" or nameLower == "idiof" then
        return true, Enum.MeshType.Sphere, "", getActiveCustomTexture(part.Name), Vector3_new(1, 1, 1)
    end
    
    local isFloorVisPart = (part:FindFirstAncestor("FloorVisualizer") ~= nil) or nameLower:find("floorvis") or (nameLower:find("visualizer") and part.Name ~= "F3X_VisualizerMeshGlobal" and part.Name ~= "F3X_VisualizedMeshGlobal" and part.Name ~= "CubeOutline")
    if nameLower == "cyl" or nameLower == "shoot" or nameLower == "cralv3" or isFloorVisPart then
        return true, Enum.MeshType.Cylinder, "", getActiveCustomTexture(part.Name), Vector3_new(1, 1, 1)
    end

    if nameLower == "floorcyl" then
        return true, Enum.MeshType.Sphere, "", getActiveCustomTexture(part.Name), Vector3_new(1, 1, 1)
    end

    if ignoredMeshParts[part.Name] then
        return false, Enum.MeshType.FileMesh, "", "", Vector3_new(1, 1, 1)
    end

    if part.Name == "HeadMeshPart" then
        return true, Enum.MeshType.FileMesh, HEAD_MESH_ID, "", HEAD_MESH_SIZE
    end

    if part.Name == "NeckMeshPart" then
        return true, Enum.MeshType.FileMesh, NECK_MESH_ID, "", NECK_MESH_SIZE
    end

    if part.Name:find("ArmIn") then
        return true, Enum.MeshType.FileMesh, ARM_IN_MESH_ID, "", ARM_IN_CUSTOM_SIZE
    elseif part.Name:find("ArmOut") then
        return true, Enum.MeshType.FileMesh, ARM_OUT_MESH_ID, "", ARM_OUT_CUSTOM_SIZE
    end

    local acc = part:FindFirstAncestorOfClass("Accessory")
    if acc and (acc.Name == "VigilanteScarfCrimson" or acc.Name == "Accessory (KemonoGlasses)") then
        local mId, mScale = "", Vector3_new(1,1,1)
        local mp = part:IsA("MeshPart") and part.MeshId ~= "" and part.MeshId or nil
        if mp then
            mId = mp
            mScale = (part.MeshSize.Magnitude > 0) and (part.Size / part.MeshSize) or part.Size
        end
        local sm = part:FindFirstChildOfClass("SpecialMesh")
        if sm and sm.MeshId ~= "" then
            mId = sm.MeshId
            mScale = sm.Scale
        end
        if mId ~= "" then
            return true, Enum.MeshType.FileMesh, mId, "", mScale
        end
    end

    if not part:FindFirstAncestor("Effects") and not isSFXPart(part) then
        if targetModelParts[part.Name] then
            local wsMeshId, wsTexId, wsScale = getWorkspaceMeshReference(part.Name)
            if wsMeshId then
                local scale = wsScale or Vector3_new(1, 1, 1)
                if part:IsA("MeshPart") and part.MeshSize.Magnitude > 0 then
                    scale = part.Size / part.MeshSize
                end
                return true, Enum.MeshType.FileMesh, wsMeshId, wsTexId or "", scale
            end
        end
    end

    local isMesh, mType, mId, mTex, mScale = false, Enum.MeshType.FileMesh, "", "", Vector3_new(1, 1, 1)

    if part.Name == "Torso" and part.Parent == char then
        local targetId = MALE_BLOCKY_TORSO
        for _, v in pairs(char:GetChildren()) do
            if v:IsA("CharacterMesh") and v.BodyPart == Enum.BodyPart.Torso then
                if tostring(v.MeshId):find("48112070") or tostring(v.MeshId):find("482240327") then
                    targetId = FEMALE_BLOCKY_TORSO
                end
            end
        end
        return true, Enum.MeshType.FileMesh, targetId, getActiveCustomTexture(part.Name), Vector3_new(1,1,1)
    end

    if limbMeshes[part.Name] and part.Parent == char then
        return true, Enum.MeshType.FileMesh, limbMeshes[part.Name], getActiveCustomTexture(part.Name), Vector3_new(1,1,1)
    end

    if part:IsA("MeshPart") and part.MeshId ~= "" then
        isMesh = true
        mType = Enum.MeshType.FileMesh
        mId = part.MeshId
        mTex = part.TextureID
        local mSize = part.MeshSize
        mScale = (mSize and mSize.Magnitude > 0) and (part.Size / mSize) or part.Size
    end

    local sm = part:FindFirstChildOfClass("SpecialMesh")
    if sm and sm.MeshId ~= "" then
        isMesh = true
        mType = (sm.MeshType == Enum.MeshType.Head and Enum.MeshType.FileMesh or sm.MeshType)
        mId = sm.MeshId
        mTex = sm.TextureId
        mScale = sm.Scale
    end

    return isMesh, mType, mId, mTex, mScale
end

local function isSyncable(part)
    if not part:IsA("BasePart") or part.Name == "HumanoidRootPart" then return false end
    if part.Name == "Baseplate" or part.Name == "NeonParts" or part.Name == "Hole" or part.Name == "Hole2" or part.Name == "Joint" then return false end
    
    if isSFXPart(part) or isKillPart(part) then return true end
    
    if part.Transparency >= 0.99 and not limbNames[part.Name] and not part.Name:find("Visualizer") and part.Name ~= "CubeOutline" then return false end
    if part.Parent and part.Parent:FindFirstChildOfClass("Humanoid") and part.Parent ~= char then return false end

    if part:IsDescendantOf(char) then
        if targetModelParts[part.Name] or limbNames[part.Name] then return true end
        if part.Parent:IsA("Accessory") or part:FindFirstAncestorOfClass("Accessory") then return true end
        if part:FindFirstAncestor("MrsStudioDummy") or part:FindFirstAncestor("Effects") or part:FindFirstAncestor("Outlines") or part:FindFirstAncestor("FloorVisualizer") or part:FindFirstAncestor("SFXFolder") or part.Name:find("Visualizer") or part.Name == "CubeOutline" then
            return true
        end
        if isHRPChild(part) then return true end
    elseif targetModelParts[part.Name] or part.Name == "ClassicSphere" or part.Name == "ClassicBall" or part.Name == "idk" or part.Name == "cralv3" or part.Name == "idiof" or part.Name == "CubeOutline" or part.Name == "F3X_VisualizerMeshGlobal" or part.Name == "F3X_VisualizedMeshGlobal" or part.Name == "HeadMeshPart" or part.Name == "NeckMeshPart" then
        return true
    end

    return false
end

local function destroyServerPart(localPart)
    local data = trackedParts[localPart]
    if data then
        trackedParts[localPart] = nil
        pendingMirror[localPart] = nil
        if data.sPart and Remote then
            task.spawn(function()
                pcall(function()
                    Remote:InvokeServer("Remove", {data.sPart})
                end)
            end)
        end
    end
end

local function mirrorPart(localPart)
    if not scriptActive then return end
    if trackedParts[localPart] or pendingMirror[localPart] then return end
    if not isSyncable(localPart) then return end
    pendingMirror[localPart] = true

    local destroyConn, parentConn
    destroyConn = localPart.Destroying:Connect(function()
        if destroyConn then destroyConn:Disconnect() end
        if parentConn then parentConn:Disconnect() end
        destroyServerPart(localPart)
    end)
    parentConn = localPart:GetPropertyChangedSignal("Parent"):Connect(function()
        if not localPart.Parent or not localPart:IsDescendantOf(game) then
            if destroyConn then destroyConn:Disconnect() end
            if parentConn then parentConn:Disconnect() end
            destroyServerPart(localPart)
        end
    end)

    local shape = "Normal"
    local isInstant = isSFXPart(localPart) or priorityParts[localPart.Name] or localPart:FindFirstAncestor("Effects") or localPart:FindFirstAncestor("SFXFolder")
    
    local function doMirror()
        if not Remote or not scriptActive then
            pendingMirror[localPart] = nil
            return
        end
        local success, sPart = pcall(function()
            return Remote:InvokeServer("CreatePart", shape, localPart.CFrame, workspace)
        end)
        pendingMirror[localPart] = nil
        if not localPart.Parent or not localPart:IsDescendantOf(game) then
            if success and sPart then
                pcall(function() Remote:InvokeServer("Remove", {sPart}) end)
            end
            return
        end

        if success and sPart then
            local hasMesh, mType, mId, mTex, mScale = getMeshInfo(localPart)
            pcall(function()
                sPart.CanQuery = false
                sPart.CanCollide = false
                sPart.Massless = true
            end)

            local initialColor = localPart.Color
            if localPart.Name:find("ArmOut") then
                initialColor = Color3.new(0, 0, 0)
            end

            local initialMaterial = localPart.Material
            if shouldBeNeon(localPart) then
                initialMaterial = Enum.Material.Neon
            end

            trackedParts[localPart] = {
                sPart = sPart,
                CFrame = localPart.CFrame,
                Mesh = hasMesh,
                MeshType = mType,
                MeshId = mId,
                TextureId = mTex,
                Scale = mScale,
                LastSize = localPart.Size,
                LastColor = initialColor,
                LastTrans = localPart.Transparency,
                LastMaterial = initialMaterial
            }

            pcall(function()
                local randomName = generateRandomString()
                Remote:InvokeServer("SyncName", {{Part = sPart, Name = randomName}})
                Remote:InvokeServer("SyncResize", {{Part = sPart, CFrame = sPart.CFrame, Size = localPart.Size}})
                Remote:InvokeServer("SyncColor", {{Part = sPart, Color = initialColor}})
                local targetTrans = isBodyOrVisualizer(localPart) and 0 or localPart.Transparency
                Remote:InvokeServer("SyncMaterial", {{Part = sPart, Material = initialMaterial, Transparency = targetTrans}})
                Remote:InvokeServer("SyncAnchor", {{Part = sPart, Anchored = true}})
                Remote:InvokeServer("SyncCollision", {{Part = sPart, CanCollide = false}})
                Remote:InvokeServer("SetLocked", {sPart}, true)
            end)

            if hasMesh then
                pcall(function()
                    Remote:InvokeServer("CreateMeshes", {{Part = sPart}})
                    Remote:InvokeServer("SyncMesh", {{
                        Part = sPart,
                        MeshType = mType,
                        MeshId = mId,
                        TextureId = mTex,
                        Scale = mScale
                    }})
                end)
            end
        end
    end

    if isInstant then
        doMirror()
    else
        task.spawn(doMirror)
    end
end

local function registerContainerFast(container)
    if not container then return end
    
    local function processObj(obj)
        if obj:IsA("BasePart") then
            if isKillPart(obj) then
                sfxKillingParts[obj] = true
                if not obj:GetAttribute("TouchBound") then
                    obj:SetAttribute("TouchBound", true)
                    obj.Touched:Connect(function(hit) processHit(hit, obj) end)
                end
            end
            mirrorPart(obj)
        end
    end

    for _, obj in ipairs(container:GetDescendants()) do
        processObj(obj)
    end
    
    container.DescendantAdded:Connect(function(des)
        processObj(des)
    end)
end

local function registerWorkspaceDirectly()
    registerContainerFast(workspace)
    workspace.ChildAdded:Connect(function(child)
        if child:IsA("BasePart") and (targetModelParts[child.Name] or isSFXPart(child) or priorityParts[child.Name]) then
            mirrorPart(child)
        end
    end)
end

local function findLimb(names)
    for _, name in ipairs(names) do
        local found = char:FindFirstChild(name, true)
        if found and found:IsA("BasePart") then return found end
    end
    return nil
end

